{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novelist.app/schemas/nov-4.json",
  "title": "Novelist project export (.nov)",
  "description": "Reconstructed from sample.nov inside Novelist.apks and the SQLite DDL embedded in libapp.so. Optional keys are omitted by the Android writer when empty; readers must treat absent and empty as equivalent.",
  "type": "object",
  "required": ["version", "code", "title", "revisions"],
  "properties": {
    "version": { "const": 4, "description": "Format version written by Novelist 2026.1.19." },
    "code": { "type": "string", "pattern": "^[0-9a-f]{8}$", "description": "Project identifier (8 hex chars). Also the local SQLite project_code and the Google Drive appdata filename stem." },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "show_table_of_contents": { "type": "boolean" },
    "apply_automatic_indentation": { "type": "boolean" },
    "last_update_date": { "type": "integer", "description": "Unix epoch milliseconds." },
    "last_cloud_sync_date": { "type": ["integer", "null"] },
    "last_backup_date": { "type": ["integer", "null"] },
    "cover": { "type": ["string", "null"], "contentEncoding": "base64", "description": "JPEG bytes, base64 encoded, no data: prefix." },
    "revisions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/revision" }
    }
  },
  "$defs": {
    "revision": {
      "type": "object",
      "required": ["number", "date"],
      "properties": {
        "number": { "type": "integer", "minimum": 1 },
        "date": { "type": "integer" },
        "book_progresses": { "type": "array", "items": { "$ref": "#/$defs/progress" } },
        "statuses": { "type": "array", "items": { "$ref": "#/$defs/status" } },
        "subplots": { "type": "array", "items": { "$ref": "#/$defs/subplot" } },
        "scenes": { "type": "array", "items": { "$ref": "#/$defs/scene" } },
        "sections": { "type": "array", "items": { "$ref": "#/$defs/section" } },
        "categories": { "type": "array", "items": { "$ref": "#/$defs/category" } }
      }
    },
    "progress": {
      "type": "object",
      "required": ["year", "month", "day", "word_count"],
      "properties": {
        "year": { "type": "integer" },
        "month": { "type": "integer", "minimum": 1, "maximum": 12 },
        "day": { "type": "integer", "minimum": 1, "maximum": 31 },
        "word_count": { "type": "integer", "minimum": 0 }
      }
    },
    "status": {
      "type": "object",
      "required": ["code", "title", "color", "ranking"],
      "properties": {
        "code": { "type": "string" },
        "title": { "type": "string" },
        "color": { "type": "integer", "description": "Unsigned ARGB (0xAARRGGBB)." },
        "ranking": { "type": "integer", "minimum": 1 }
      }
    },
    "subplot": {
      "type": "object",
      "required": ["code", "title", "color", "ranking"],
      "properties": {
        "code": { "type": "string" },
        "title": { "type": "string" },
        "color": { "type": "integer" },
        "ranking": { "type": "integer", "minimum": 1 }
      }
    },
    "scene": {
      "type": "object",
      "required": ["code", "title", "ranking"],
      "properties": {
        "code": { "type": "string" },
        "title": { "type": "string" },
        "synopsis": { "type": "string" },
        "text": { "type": "string", "description": "Plain text with blank-line paragraph separators." },
        "ranking": { "type": "integer", "minimum": 1 },
        "status": { "type": "string", "description": "status.code" },
        "scene_items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["code"],
            "properties": { "code": { "type": "string" } }
          }
        },
        "scene_subplots": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "subplot": { "type": "string" },
              "synopsis": { "type": "string" }
            }
          }
        },
        "scene_notes": {
          "type": "array",
          "description": "Present in the SQLite schema (scene_note); not emitted by sample.nov.",
          "items": {
            "type": "object",
            "properties": { "text": { "type": "string" }, "ranking": { "type": "integer" } }
          }
        },
        "scene_pictures": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "picture": { "type": "string", "contentEncoding": "base64" },
              "ranking": { "type": "integer" }
            }
          }
        }
      }
    },
    "section": {
      "type": "object",
      "required": ["code", "title", "ranking"],
      "properties": {
        "code": { "type": "string" },
        "title": { "type": "string" },
        "synopsis": { "type": "string" },
        "ranking": { "type": "integer", "minimum": 1 },
        "section_scenes": {
          "type": "array",
          "description": "Ordered scene membership. A scene may appear in only one section.",
          "items": {
            "type": "object",
            "required": ["code", "ranking"],
            "properties": {
              "code": { "type": "string" },
              "ranking": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    "category": {
      "type": "object",
      "required": ["code", "title", "color", "ranking"],
      "properties": {
        "code": { "type": "string" },
        "title": { "type": "string" },
        "color": { "type": "integer" },
        "ranking": { "type": "integer", "minimum": 1 },
        "metadata_groups": { "type": "array", "items": { "$ref": "#/$defs/metadataGroup" } },
        "items": { "type": "array", "items": { "$ref": "#/$defs/item" } }
      }
    },
    "metadataGroup": {
      "type": "object",
      "required": ["code", "title", "ranking"],
      "properties": {
        "code": { "type": "string" },
        "title": { "type": "string" },
        "ranking": { "type": "integer" },
        "metadata_elements": { "type": "array", "items": { "$ref": "#/$defs/metadataElement" } }
      }
    },
    "metadataElement": {
      "type": "object",
      "required": ["code", "title", "ranking"],
      "properties": {
        "code": { "type": "string", "description": "In template_standard_novel.json the codes carry a legacy '.jpg' suffix, e.g. 'cf0e2684.jpg'." },
        "title": { "type": "string" },
        "ranking": { "type": "integer" },
        "is_relevant": { "type": "boolean" }
      }
    },
    "item": {
      "type": "object",
      "required": ["code", "title", "ranking"],
      "properties": {
        "code": { "type": "string" },
        "title": { "type": "string" },
        "synopsis": { "type": "string" },
        "ranking": { "type": "integer" },
        "status": { "type": "string" },
        "item_tags": {
          "type": "array",
          "items": { "type": "object", "properties": { "tag": { "type": "string" } } }
        },
        "item_names": {
          "type": "array",
          "description": "Aliases shown under the item title.",
          "items": {
            "type": "object",
            "required": ["code", "name", "ranking"],
            "properties": {
              "code": { "type": "string" },
              "name": { "type": "string" },
              "ranking": { "type": "integer" }
            }
          }
        },
        "item_metadatas": {
          "type": "array",
          "description": "Values for the category's metadata elements.",
          "items": {
            "type": "object",
            "properties": {
              "metadata_element": { "type": "string" },
              "value": { "type": "string" }
            }
          }
        },
        "item_relationships": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "other_item": { "type": "string", "description": "item.code of the related item." },
              "description": { "type": "string" },
              "ranking": { "type": "integer" },
              "is_relevant": { "type": "boolean" }
            }
          }
        },
        "item_notes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": { "text": { "type": "string" }, "ranking": { "type": "integer" } }
          }
        },
        "item_pictures": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "picture": { "type": "string", "contentEncoding": "base64" },
              "ranking": { "type": "integer" }
            }
          }
        }
      }
    }
  }
}
